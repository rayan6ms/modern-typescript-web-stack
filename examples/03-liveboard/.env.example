# Optional PUBLIC managed Convex deployment URL. Leave empty for the local shell.
# Obtain the actual URL only after deployment/region/budget approval.
# Vite embeds VITE_ values at build time: never put secrets here.
VITE_CONVEX_URL=
# Future Convex CLI deployment selector belongs in ignored .env.local.
# No selector, deploy key, token, or identity provider is configured now.
