{
  "name": "liveboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "RAYON_NUM_THREADS=2 UV_THREADPOOL_SIZE=2 bun --bun vite build",
    "check": "BIOME_MAX_THREADS=2 bun --bun biome check .",
    "dev": "bun --bun vite --host 127.0.0.1 --port 3000 --strictPort",
    "fix": "BIOME_MAX_THREADS=2 bun --bun biome check --write .",
    "start": "bun .output/server/index.mjs",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "convex": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "ultracite": "7.12.4",
    "vite": "8.3.4"
  },
  "packageManager": "bun@1.4.0"
}
